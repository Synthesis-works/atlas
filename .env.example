APP_NAME="Atlas"
ENVIRONMENT="development"
DEBUG=true

# Database
# In Docker Compose, the db host is 'db'
DATABASE_URL="postgresql://postgres:postgres@db:5432/atlas"

# Celery
CELERY_BROKER_URL="redis://redis:6379/0"
CELERY_RESULT_BACKEND="redis://redis:6379/0"

# Authentication
JWT_SECRET="dev-secret-key-do-not-use-in-production"

# Production hardening (Vercel API + worker)
# In production ENVIRONMENT must be "production"; the app then refuses to
# start while JWT_SECRET is still the development default above.
# ENVIRONMENT="production"
# DEBUG=false
# CORS_ORIGINS='["https://your-app.vercel.app"]'   # JSON list, required for the browser
# WORKER_AUTH_TOKEN="generate-a-long-random-string"
# ATLAS_ARTIFACT_DIR="/var/lib/atlas/artifacts"

# Logging
LOG_LEVEL="INFO"
